# ============================================
# LLM Provider Configuration
# Choose ONE of the following three options
# ============================================

# --- Option 1: OpenAI ---
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4

# --- Option 2: Anthropic Claude ---
# ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# --- Option 3: NVIDIA NIM (OpenAI-compatible) ---
# NIM_API_KEY=your-nvidia-api-key-here
# NIM_MODEL=meta/llama3-70b-instruct
# NIM_BASE=https://integrate.api.nvidia.com/v1

# ============================================
# Screener.in Unofficial API
# ============================================
# SCREENER_API_BASE_URL=http://127.0.0.1:8000
# SCREENER_API_KEY=optional-api-key

# ============================================
# Alpha Vantage API (supplementary data source)
# ============================================
# Get a free API key at: https://www.alphavantage.co/support/#api-key
# Free tier: 5 calls/minute, 500 calls/day
# Provides: RSI, MACD, SMA, Bollinger Bands, Company Overview, FX rates
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ============================================
# Screener.in Unofficial API Cache Settings
# ============================================

# SCREENER_CACHE_TTL=300          # Cache TTL in seconds (default: 300 = 5 min)
                                 # Set to 0 to always fetch fresh data
                                 # Or use --fresh flag when running analysis

# ============================================
# Default Analysis Settings
# ============================================
# DEFAULT_EXCHANGE=NSE
# DEFAULT_ANALYSIS_TYPE=full
# DEFAULT_MAX_ROUND=12
# DEFAULT_OUTPUT_FORMAT=txt       # Output format: txt or md
# DEFAULT_OUTPUT_DIR=reports      # Directory to save reports
